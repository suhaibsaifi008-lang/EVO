# ---- Language core ----
# Primary: any OpenAI-compatible endpoint
JARVIS_OPENAI_API_KEY=freellmapi-...
JARVIS_OPENAI_BASE_URL=http://localhost:3001/v1
JARVIS_OPENAI_MODEL=auto

# Fallback brain (used automatically when primary is unreachable):
# Install Ollama (ollama.com) and pull a model, e.g.: ollama pull llama3.1
JARVIS_OLLAMA_ENABLED=1
JARVIS_OLLAMA_URL=http://localhost:11434/v1
JARVIS_OLLAMA_MODEL=llama3.1

# ---- Identity ----
JARVIS_NAME=EVO
JARVIS_USER_ADDRESS=sir
JARVIS_AGENT_MODE=1

# ---- Model routing (optional) ----
# A cheaper/faster model for trivial questions ("what time is it").
# JARVIS_FAST_MODEL=gpt-4o-mini

# ---- Phone push via ntfy (optional) ----
# Install the ntfy app, subscribe to a private topic name, put it here.
# JARVIS_NTFY_TOPIC=your-secret-topic-name

# ---- Smart home via Home Assistant (optional) ----
# JARVIS_HA_URL=http://homeassistant.local:8123
# JARVIS_HA_TOKEN=long-lived-access-token

# ---- Multi-room satellite ear (optional) ----
# Run jarvis_ear.pyw on another PC pointing at this server:
# JARVIS_SERVER_URL=http://192.168.1.10:8420

# ---- Telegram presence (optional) ----
# 1. Talk to @BotFather on Telegram -> /newbot -> copy the token here
# 2. Message your bot once; EVO pairs to your chat automatically.
# JARVIS_TELEGRAM_TOKEN=123456:ABC-your-token
# JARVIS_TELEGRAM_CHAT_IDS=123456789

# ---- Email (optional) ----
# Use an app password, never your real one.
# JARVIS_MAIL_ADDRESS=you@gmail.com
# JARVIS_MAIL_PASSWORD=abcd-efgh-ijkl-mnop
# JARVIS_SMTP_HOST=smtp.gmail.com
# JARVIS_SMTP_PORT=587
# JARVIS_IMAP_HOST=imap.gmail.com
# JARVIS_IMAP_PORT=993
