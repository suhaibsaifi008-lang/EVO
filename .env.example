# ---- Language core ----
# Primary: any OpenAI-compatible endpoint (OpenAI, OpenRouter, FreeLLMAPI,
# LM Studio, vLLM, or Ollama's /v1). Provider-agnostic - EVO routes by ROLE.
# TIP: fully offline brain:
#   JARVIS_OPENAI_API_KEY=local
#   JARVIS_OPENAI_BASE_URL=http://localhost:11434/v1
JARVIS_OPENAI_API_KEY=freellmapi-...
JARVIS_OPENAI_BASE_URL=http://localhost:3001/v1
JARVIS_OPENAI_MODEL=auto

# ---- Model roles (optional; each falls back to PRIMARY when unset) ----
# Fast model: trivial turns, summaries, memory extraction
# JARVIS_MODEL_FAST=gpt-4o-mini
# Reasoning model: hard analysis / deep thought
# JARVIS_MODEL_REASONING=o4-mini
# Vision model: screen understanding
# JARVIS_MODEL_VISION=gpt-4o
# Fallback model: tried when every provider fails (then Ollama)
# JARVIS_MODEL_FALLBACK=qwen3:4b

# Fallback brain (used automatically when primary is unreachable):
# Install Ollama (ollama.com), pull a model, then put its EXACT name here
# (check with: ollama list). A wrong name = HTTP 404.
JARVIS_OLLAMA_ENABLED=1
JARVIS_OLLAMA_URL=http://localhost:11434/v1
JARVIS_OLLAMA_MODEL=qwen3:4b

# ---- Identity ----
JARVIS_NAME=EVO
JARVIS_USER_ADDRESS=sir
JARVIS_AGENT_MODE=1

# ---- Model routing (optional) ----
# A cheaper/faster model for trivial questions ("what time is it").
# JARVIS_FAST_MODEL=gpt-4o-mini

# ---- Phone push via ntfy (optional) ----
# Install the ntfy app, subscribe to a private topic name, put it here.
# JARVIS_NTFY_TOPIC=your-secret-topic-name

# ---- Smart home via Home Assistant (optional) ----
# JARVIS_HA_URL=http://homeassistant.local:8123
# JARVIS_HA_TOKEN=long-lived-access-token

# ---- Realtime voice (optional, recommended) ----
# Gemini Live gives EVO true duplex conversation: you talk over it, it
# interrupts back, natural turn-taking - like ChatGPT's voice mode.
# Get a FREE key at https://aistudio.google.com and paste it below.
# Without it, EVO uses its fully-offline Vosk voice automatically.
# GEMINI_API_KEY=paste-your-key-here
# JARVIS_GEMINI_MODEL=gemini-2.0-flash-live-001
# Force the offline engine even when a key exists:
# JARVIS_VOICE_ENGINE=vosk

# ---- Wake word ----
# Comma-separated phrases that wake EVO up (matched offline via Vosk).
# Set it empty (JARVIS_WAKE_PHRASES=) to use the pretrained 'hey jarvis'
# openWakeWord audio model instead.
JARVIS_WAKE_PHRASES=wake up evo,wake up e.v.o

# ---- Multi-room satellite ear (optional) ----
# Run evo_ear.pyw on another PC pointing at this server:
# JARVIS_SERVER_URL=http://192.168.1.10:8420

# ---- Telegram presence (optional) ----
# 1. Talk to @BotFather on Telegram -> /newbot -> copy the token here
# 2. Message your bot once; EVO pairs to your chat automatically.
# JARVIS_TELEGRAM_TOKEN=123456:ABC-your-token
# JARVIS_TELEGRAM_CHAT_IDS=123456789

# ---- Email (optional) ----
# Use an app password, never your real one.
# JARVIS_MAIL_ADDRESS=you@gmail.com
# JARVIS_MAIL_PASSWORD=abcd-efgh-ijkl-mnop
# JARVIS_SMTP_HOST=smtp.gmail.com
# JARVIS_SMTP_PORT=587
# JARVIS_IMAP_HOST=imap.gmail.com
# JARVIS_IMAP_PORT=993
